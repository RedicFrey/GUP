# Copie este arquivo para .env (cp .env.example .env) e preencha com os seus valores.
# O .env está no .gitignore: nunca faça commit dele nem cole chaves aqui.

# Chave das sessões do Flask. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Banco MySQL via SQLAlchemy (o schema.sql cria o banco gup_db com os dados iniciais).
# Formato: mysql+pymysql://usuario:senha@host:porta/nome_do_banco
# Sem DATABASE_URL o backend usa um SQLite em backend/instance/gup.db (só para testes).
DATABASE_URL=mysql+pymysql://root:senha@localhost:3306/gup_db

# 1 liga o modo debug do Flask (só na sua máquina)
FLASK_DEBUG=0

# Envio de avisos por e-mail (SMTP do Gmail). Opcional: vazio, os e-mails são ignorados.
# MAIL_APP_PASSWORD é uma "senha de app" do Google, não a senha da conta.
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=GUP
