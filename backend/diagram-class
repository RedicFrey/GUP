    TaskModel "1" --> "0..*" TaskAssignmentModel : task_id
    ChildProfile "1" --> "0..*" TaskAssignmentModel : child_profile_id

    %% Moedas, recompensas e resgates
    ChildProfile "1" --> "0..*" CoinHistoryModel : child_profile_id
    ChildProfile "1" --> "0..*" RedemptionModel : child_profile_id
